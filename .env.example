# Provider Configuration
# CHAT_PROVIDER: openai | clova | gemini
CHAT_PROVIDER=openai
CHAT_MODEL=gpt-4o-mini
DETECT_MODEL=gpt-4o-mini

# Rerank Configuration
# RERANK_PROVIDER: openai | clova | gemini
RERANK_PROVIDER=openai
RERANK_MODEL=gpt-4o-mini

# API Keys (use the ones that match your providers)
OPENAI_API_KEY=sk-your-api-key-here
CLOVA_KEY=clova-api-key-here
GEMINI_API_KEY=gemini-api-key-here

# LLM Reranking CSV Logging (optional)
# Set to "true" to enable CSV logging of reranking comparisons
# Logs will be saved to logs/rerank_comparison.csv
RERANK_CSV_LOG=false
